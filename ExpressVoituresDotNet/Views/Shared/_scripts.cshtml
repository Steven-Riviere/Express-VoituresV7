<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {

        // Fonction pour charger les modèles en fonction de la marque sélectionnée
        function loadVehicleModels(brandId) {
            var vehicleModelSelect = document.getElementById('VehicleModelId');
            if (!vehicleModelSelect) return;

            if (brandId) {
                fetch('/VehicleBrandVehicleModel/GetModelsByBrand?brandId=' + brandId)

                    .then(response => response.json())
                    .then(data => {
                        if (data.length > 0) {
                            data.forEach(function (item) {
                                var option = new Option(item.model, item.id);
                                vehicleModelSelect.appendChild(option);
                            });
                        } else {
                            vehicleModelSelect.appendChild(new Option('-- Pas de modèle pour cette marque --', ''));
                        }
                    })
                    .catch(error => console.error('Erreur:', error));
            } else {
                vehicleModelSelect.appendChild(new Option('-- Sélectionnez une marque --', ''));
            }
        }

        // Charger les modèles si une marque est déjà sélectionnée
        const brandSelect = document.getElementById('VehicleBrandId');
        if (brandSelect) {
            const selectedBrandId = brandSelect.value;
            loadVehicleModels(selectedBrandId);

            // Gérer le changement de marque
            brandSelect.addEventListener('change', function () {
                loadVehicleModels(this.value);
            });
        }

        // ----- Gestion des inputs prix -----
        const forms = document.querySelectorAll('form');
        forms.forEach(function (form) {
            form.addEventListener('submit', function () {
                const prixInputs = form.querySelectorAll('input.prix');
                prixInputs.forEach(function (input) {
                    input.value = input.value.replace(',', '.');
                });
            });
        });
    });
</script>
